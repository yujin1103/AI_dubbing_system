# Preserved diarize env vars (v178 baseline + v190/v194 patches)
# Apply via: export $(cat configs/preserved/diarize_env.env | xargs)

# v178: 11 critical env vars
DIARIZEN_MODEL=WavLM-large-s80-md-v2
DIARIZEN_NUM_SPEAKERS=auto
DIARIZEN_VAD_AGGRESSIVENESS=2

# v178: TimeGapSplit + ASD-gated FaceTrack + singleton-skip
TIME_GAP_SPLIT=1
ASD_GATED_FACE_TRACK=1
SINGLETON_SKIP=1

# v190: visual ASD + focused NeMo re-diarize
VISUAL_ASD_TRIGGER=1
FOCUSED_NEMO_RE_DIARIZE=1
FOCUSED_NEMO_WINDOW_PAD=3.0
FOCUSED_NEMO_NUM_SPEAKERS=2
FOCUSED_NEMO_MIN_DUR=1.5
FOCUSED_NEMO_GAP_MIN=2.0

# v194: word-level intra-segment split
WORD_LEVEL_SPLIT=1
WORD_F0_JUMP_HZ=100
WORD_LR_COS_MAX=0.35
WORD_SIDE_SIM_MIN=0.40

# repair (영상별 sweep best)
REPAIR_PHASE_A=1
REPAIR_PHASE_B=1
REPAIR_PHASE_C=1
REPAIR_PHASE_D=1
REPAIR_PHASE_E=1
REPAIR_PHASE_F=1

# LatentSync per-video (set ONLY ONE)
# test4: LATENTSYNC_OUTLIER_OFF=1
# test5: LATENTSYNC_OUTLIER_FAR_THRESH=0.70
